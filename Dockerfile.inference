FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 DATA_DIR=/data RULES_DIR=/app/rules MODELS_DIR=/models YOLO_DEVICE=cuda:0 INFERENCE_BIND_HOST=0.0.0.0
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app/backend
COPY backend/pyproject.toml ./
COPY backend/app ./app
RUN pip install --no-cache-dir '.[yolo]'
COPY rules /app/rules
COPY backend/start-inference.sh ./start-inference.sh
RUN mkdir -p /data /models
EXPOSE 8000
CMD ["./start-inference.sh"]
