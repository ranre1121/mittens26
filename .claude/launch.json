{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && API_KEYS=${API_KEYS:-dev-key} .venv/bin/uvicorn app.api:app --port 8000"],
      "port": 8000
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev"],
      "port": 3000
    }
  ]
}
