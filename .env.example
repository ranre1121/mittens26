# Copy to .env; docker compose reads it. For local runs, export these in the shell.

# Keys accepted in X-API-Key by /api/v1/*. Comma-separated. Empty = every jury request is rejected.
# Generate one with: openssl rand -hex 16
API_KEYS=

# Largest accepted upload, in MB.
MAX_UPLOAD_MB=500

# Analysis attempts per job when the worker is interrupted (restart recovery).
MAX_ATTEMPTS=3

# Frames per second the pipeline samples for detection.
SAMPLE_FPS=2

# Stub detector until a model is integrated: "none" reports nothing,
# "demo" reports one synthetic event per video (for testing only, never for judging).
STUB_MODE=none

# Cite rule references that are not yet marked verified in rules/registry.json.
ALLOW_UNVERIFIED_RULES=false
