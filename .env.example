# Local development defaults. No Qwen weights are loaded by the mock provider.
APP_ENV=development
QWEN_PROVIDER=mock
QWEN_MODEL_ID=qwen-stub
QWEN_MODEL_VERSION=mock-v1
QWEN_COMMAND_JSON=[]

# X-API-Key protects ALL data/media routes when configured.
# Empty: UI routes work on loopback only; jury routes still reject requests.
API_KEYS=
MAX_UPLOAD_MB=500
MAX_VIDEO_SECONDS=1800
MAX_PENDING_JOBS=20
JOB_TIMEOUT_SECONDS=120
MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=1
SAMPLE_FPS=2

# Optional accepted ensemble manifest; weights stay outside Git. CPU only.
YOLO_CONFIG=
# Equipment is intentionally excluded from Qwen context.
# Legacy STUB_MODE=demo is rejected; no synthetic compliance events.
STUB_MODE=none
ALLOW_UNVERIFIED_RULES=false
# scripts/local.sh never opens a public tunnel unless explicitly enabled.
EXPOSE_TUNNEL=false
