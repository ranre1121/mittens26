# Local development defaults. No Qwen weights are loaded by the mock provider.
APP_ENV=development
QWEN_PROVIDER=mock
# Model ID/version default to the selected provider; set only for command providers.
QWEN_COMMAND_JSON=[]
QWEN_MODEL_DIR=
QWEN_MODEL_REVISION=0c351dd01ed87e9c1b53cbc748cba10e6187ff3b
QWEN_QUANTIZATION=bf16
QWEN_ADAPTER_DIR=
QWEN_ALLOW_EXPERIMENTAL_ADAPTER=false
QWEN_MAX_WINDOWS=8
QWEN_MAX_FRAMES_PER_WINDOW=6
QWEN_MAX_NEW_TOKENS=1024
QWEN_MAX_INPUT_TOKENS=8192
QWEN_WINDOW_SECONDS=6
QWEN_STRIDE_SECONDS=4
QWEN_GENERATION_TIMEOUT_SECONDS=90

# X-API-Key protects ALL data/media routes when configured.
# Empty: UI routes work on loopback only; jury routes still reject requests.
API_KEYS=
MAX_UPLOAD_MB=500
MAX_VIDEO_SECONDS=1800
MAX_PENDING_JOBS=20
JOB_TIMEOUT_SECONDS=600
MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=1
SAMPLE_FPS=2

# Accepted ensemble manifest; weights stay outside Git. NVIDIA service uses cuda:0.
YOLO_CONFIG=
# Equipment is intentionally excluded from Qwen context.
# Legacy STUB_MODE=demo is rejected; no synthetic compliance events.
STUB_MODE=none
ALLOW_UNVERIFIED_RULES=false
# scripts/local.sh never opens a public tunnel unless explicitly enabled.
EXPOSE_TUNNEL=false

INFERENCE_API_URL=
INFERENCE_API_KEY=
INFERENCE_TIMEOUT_MS=30000
YOLO_DEVICE=cpu
